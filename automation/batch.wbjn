# encoding: utf-8
# 2026 R1
# EPTC 2026 batch journal. Runs one chunk of designs through the Workbench project.
#
# Started by run_batch.py, not by hand:
#   RunWB2.exe -B -R batch.wbjn     with the env var EPTC_JOB pointing to a job file
#
# The job file is plain "key=value" lines written by run_batch.py:
#   archive=<path to eptc.wbpz>
#   project=<path to the restored .wbpj in the work folder>
#   inputs=<chunk input file, tab separated, header row first>
#   outputs=<chunk output file, tab separated, appended one row per design>
#
# Approach: one design at a time on the current design point (DP 0). Set the
# inputs, Update(), read the outputs, write a row, move on. A failed design is
# written as status=failed and the loop carries on.
#
# Lines marked VERIFY are calls not yet checked against a journal recorded on
# 2026 R1 (File > Scripting > Record Journal). Check those first.
SetScriptVersion(Version="26.1.175")

import os
import time

# Contract column -> (Workbench parameter, scale, unit). The value written to
# Workbench is "<value * scale> [<unit>]". Contract units in the input file:
#   k W/mK, E Pa, a 1/K (= 1/C), blt um, h W/m2K.
# Explicit units in the expression make the project unit system irrelevant.
# P1-P4 belong to material "TIM 1" and P5-P8 to "TIM 2" (from journal4.wbjn:
# P1-P4 were created on the original TIM, which was renamed "TIM 1").
INPUT_MAP = {
    "E1": ("P1", 1.0, "Pa"),
    "a1": ("P3", 1.0, "C^-1"),
    "k1": ("P4", 1.0, "W m^-1 C^-1"),
    "E2": ("P5", 1.0, "Pa"),
    "a2": ("P7", 1.0, "C^-1"),
    "k2": ("P8", 1.0, "W m^-1 C^-1"),
    # Not parameters in the model. BLT reaches the model through k and E (thin-layer
    # equivalence in run_batch.py); the film coefficient is fixed at 150 W/m2K.
    "blt1": (None, 1e-3, "mm"),
    "blt2": (None, 1e-3, "mm"),
    "h": (None, 1.0, "W m^-2 C^-1"),
}

# Poisson's ratio is fixed at 0.45. P2 and P6 are pinned to that value every
# run until the P boxes are unticked in Engineering Data.
FIXED = {"P2": "0.45", "P6": "0.45"}

# Contract output column -> Workbench parameter. Values are written raw
# ("629.25 [C]"); run_batch.py converts the units.
# P numbers from the V2 Parameter Set (29 Oct). P11-P18 (old "scope" stresses,
# bodies never checked) are left out on purpose.
OUTPUT_MAP = [
    ("Tj", "P10"),                 # Temperature scope Maximum, scoped to Silicon Die
    ("Tmin", "P9"),                # Temperature scope Minimum
    ("Tcase", "P19"),              # Tcase lid top Maximum (lid top face, above the die)
    ("Tcase_avg", "P20"),          # Tcase lid top Average
    ("Q_out", "P21"),              # Heat out convection Heat (negative = leaving)
    ("tim1_vm_avg", "P22"),        # Avg stress TIM1 Average (von Mises, TIM-1 body)
    ("tim1_vm_max", "P23"),
    ("tim2_vm_avg", "P25"),        # Avg stress TIM2 Average
    ("tim2_vm_max", "P24"),
    ("tim1_edge_shear_max", "P29"),  # Max shear on Edge Path TIM1 (0.5-1.5 mm in, mid-plane)
    ("tim1_edge_shear_avg", "P30"),
    ("tim2_edge_shear_max", "P31"),  # Max shear on Edge Path TIM2
    ("tim2_edge_shear_avg", "P32"),
    ("deform_total_max", "P26"),   # Total Deformation Maximum, all bodies
    ("warp_y_max", "P27"),         # Warpage Y Maximum, substrate only
    ("warp_y_min", "P28"),
]


def read_job():
    path = os.environ.get("EPTC_JOB")
    if not path:
        from System import Environment  # VERIFY: os.environ is normally enough in IronPython
        path = Environment.GetEnvironmentVariable("EPTC_JOB")
    job = {}
    for line in open(path):
        line = line.strip()
        if line and "=" in line:
            key, value = line.split("=", 1)
            job[key.strip()] = value.strip()
    return job


def read_rows(path):
    lines = [l.rstrip("\r\n") for l in open(path) if l.strip()]
    header = lines[0].split("\t")
    return [dict(zip(header, l.split("\t"))) for l in lines[1:]]


def clean(text):
    return str(text).replace("\t", " ").replace("\r", " ").replace("\n", " ")[:400]


def write_row(path, values):
    f = open(path, "a")
    f.write("\t".join([clean(v) for v in values]) + "\n")
    f.close()


job = read_job()
if os.path.exists(job["project"]):
    Open(FilePath=job["project"])  # VERIFY
else:
    Unarchive(ArchivePath=job["archive"], ProjectPath=job["project"], Overwrite=True)  # VERIFY

designPoint = Parameters.GetDesignPoint(Name="0")
out_cols = [name for name, pid in OUTPUT_MAP]
if not os.path.exists(job["outputs"]):
    write_row(job["outputs"], ["run_id", "status"] + out_cols + ["solve_time_s", "error_message"])

for name, value in FIXED.items():
    designPoint.SetParameterExpression(Parameter=Parameters.GetParameter(Name=name), Expression=value)

for row in read_rows(job["inputs"]):
    start = time.time()
    try:
        for col, (pid, scale, unit) in INPUT_MAP.items():
            if pid is None:
                continue
            if row.get(col, "") == "":
                # A skipped input would silently keep the previous design's value
                raise ValueError("input %s is blank" % col)
            expr = "%.9g [%s]" % (float(row[col]) * scale, unit)
            designPoint.SetParameterExpression(Parameter=Parameters.GetParameter(Name=pid), Expression=expr)
        Update()  # updates the current design point: thermal, then structural
        values = []
        for name, pid in OUTPUT_MAP:
            if pid is None:
                values.append("")
            else:
                values.append(designPoint.GetParameterValue(Parameters.GetParameter(Name=pid)))  # VERIFY: returns a Quantity, str() gives "629.25 [C]"
        write_row(job["outputs"], [row["run_id"], "solved"] + values + ["%.1f" % (time.time() - start), ""])
    except Exception as e:
        write_row(job["outputs"], [row["run_id"], "failed"] + [""] * len(out_cols) + ["%.1f" % (time.time() - start), e])
